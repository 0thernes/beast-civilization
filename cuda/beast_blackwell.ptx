// Bare-metal PTX 7.8 / sm_80 forward-compatible GPU kernels JIT-compiled natively by nvcuda.dll
// onto NVIDIA RTX 5070 Ti (Blackwell sm_120) with ZERO nvcc and ZERO MSVC dependency!
//
// Kernel 1: `beast_b158_rowdot` — 5-trit/byte packed b1.58 ternary matrix-vector product (3^5 = 243 <= 256)
//           Computes `out[row] = sum_{b=0}^{n_bytes-1} sum_{t=0}^{4} trit(W[row*n_bytes + b], t) * x[b*5 + t]`
//           Bit-exact int64 parity with Zig `beast_dot_b158_ref` / `beast_dot_b158_simd`!

.version 7.8
.target sm_80
.address_size 64

.visible .entry beast_b158_rowdot(
    .param .u64 p_packed_w,
    .param .u64 p_x,
    .param .u64 p_out,
    .param .u32 p_rows,
    .param .u32 p_bytes_per_row
)
{
    .reg .pred %p<4>;
    .reg .u32 %r<24>;
    .reg .s32 %rs<12>;
    .reg .u64 %rd<12>;
    .reg .s64 %acc, %term;

    // row = blockIdx.x * blockDim.x + threadIdx.x
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %ntid.x;
    mov.u32 %r2, %tid.x;
    mad.lo.u32 %r3, %r0, %r1, %r2;

    ld.param.u32 %r4, [p_rows];
    setp.ge.u32 %p0, %r3, %r4;
    @%p0 bra DONE;

    ld.param.u64 %rd0, [p_packed_w];
    ld.param.u64 %rd1, [p_x];
    ld.param.u64 %rd2, [p_out];
    ld.param.u32 %r5, [p_bytes_per_row];

    // row_w_ptr = p_packed_w + row * bytes_per_row
    mul.wide.u32 %rd3, %r3, %r5;
    add.u64 %rd4, %rd0, %rd3;

    mov.s64 %acc, 0;
    mov.u32 %r6, 0; // byte index b

LOOP_BYTE:
    setp.ge.u32 %p1, %r6, %r5;
    @%p1 bra STORE;

    // load packed byte -> %r7
    cvt.u64.u32 %rd5, %r6;
    add.u64 %rd6, %rd4, %rd5;
    ld.global.u8 %r7, [%rd6];

    // base x index = b * 5 -> %r8
    mul.lo.u32 %r8, %r6, 5;
    mov.u32 %r9, 0; // trit lane t in 0..4

LOOP_TRIT:
    setp.ge.u32 %p2, %r9, 5;
    @%p2 bra NEXT_BYTE;

    // rem = code % 3; code = code / 3; trit = rem - 1 in {-1, 0, +1}
    rem.u32 %r10, %r7, 3;
    div.u32 %r7, %r7, 3;
    sub.s32 %rs0, %r10, 1;

    // load x[b*5 + t]
    add.u32 %r11, %r8, %r9;
    mul.wide.u32 %rd7, %r11, 4;
    add.u64 %rd8, %rd1, %rd7;
    ld.global.s32 %rs1, [%rd8];

    // acc += (s64)trit * (s64)x
    mul.wide.s32 %term, %rs0, %rs1;
    add.s64 %acc, %acc, %term;

    add.u32 %r9, %r9, 1;
    bra LOOP_TRIT;

NEXT_BYTE:
    add.u32 %r6, %r6, 1;
    bra LOOP_BYTE;

STORE:
    mul.wide.u32 %rd9, %r3, 8;
    add.u64 %rd10, %rd2, %rd9;
    st.global.s64 [%rd10], %acc;

DONE:
    ret;
}
